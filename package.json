{
  "name": "pi-runline",
  "version": "0.45.0",
  "description": "Code mode for pi",
  "type": "commonjs",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "extensions/runline-context"
    ]
  },
  "scripts": {
    "typecheck": "tsc",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "runline": "0.45.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "author": "michaelliv",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.5.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michaelliv/pi-runline.git"
  },
  "homepage": "https://github.com/Michaelliv/pi-runline#readme",
  "bugs": {
    "url": "https://github.com/Michaelliv/pi-runline/issues"
  }
}
